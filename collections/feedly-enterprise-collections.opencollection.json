{
  "opencollection": "1.0.0",
  "info": {
    "name": "Enterprise Collections",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Folders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all team folders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.feedly.com/v3/enterprise/collections",
            "params": [
              {
                "name": "includeArchived",
                "value": "false",
                "type": "query",
                "description": "Include archived folders in the response (default is false)"
              },
              {
                "name": "format",
                "value": "json",
                "type": "query",
                "description": "Export format for the response"
              }
            ]
          },
          "docs": "Retrieve a list of all team folders with their associated feeds. Supports CSV export via the `format=csv` query parameter."
        }
      ]
    }
  ],
  "bundled": true
}