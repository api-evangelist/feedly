      "name": "Entity Lists",
      "description": {
        "content": "Manage and retrieve enterprise entity lists",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2716be04-6fb8-49b9-ba05-fe127ab6c0da",
          "name": "Get Intel Profile data",
          "request": {
            "name": "Get Intel Profile data",
            "description": {
              "content": "Returns all intel profiles associated with the authenticated enterprise account. When `details=true` is passed, each list includes its full entity membership. Entity lists group named entities (companies, technologies, threat actors, custom text terms) that can be used to scope and filter intelligence feeds.\n\nEntity members may be resolved Feedly entities (returned with an `id`) or unresolved custom text strings (returned with a `text` field only).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "enterprise",
                "entityLists"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "details",
                  "value": "false",
                  "description": "When `true`, each entity list object includes the full `entities` array with all member IDs and text values. When omitted or `false`, the `entities` array is empty or absent.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
